<mxfile host="app.diagrams.net">
  <diagram name="System Architecture" id="sad1">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="850" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Client Layer -->
        <mxCell id="client" value="Client Layer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontStyle=1;fontSize=14;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="360" y="40" width="380" height="120" as="geometry" />
        </mxCell>
        <mxCell id="client1" value="React.js Frontend (Browser)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="380" y="70" width="150" height="40" as="geometry" />
        </mxCell>
        <mxCell id="client2" value="Customer UI / Provider Dashboard / Admin Panel" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="550" y="70" width="170" height="40" as="geometry" />
        </mxCell>
        <mxCell id="hostVercel" value="Hosted on: Vercel" style="text;fontStyle=2;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="380" y="120" width="340" height="20" as="geometry" />
        </mxCell>

        <!-- Backend Layer -->
        <mxCell id="backend" value="Backend / API Layer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontStyle=1;fontSize=14;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="300" y="230" width="500" height="150" as="geometry" />
        </mxCell>
        <mxCell id="be1" value="FastAPI (REST API)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="320" y="260" width="140" height="35" as="geometry" />
        </mxCell>
        <mxCell id="be2" value="Auth (JWT)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="320" y="305" width="110" height="35" as="geometry" />
        </mxCell>
        <mxCell id="be3" value="Booking Service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="440" y="305" width="110" height="35" as="geometry" />
        </mxCell>
        <mxCell id="be4" value="Provider Service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="560" y="305" width="110" height="35" as="geometry" />
        </mxCell>
        <mxCell id="be5" value="Payment Service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="680" y="305" width="100" height="35" as="geometry" />
        </mxCell>
        <mxCell id="hostRender" value="Hosted on: Render" style="text;fontStyle=2;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="300" y="350" width="500" height="20" as="geometry" />
        </mxCell>

        <!-- Database Layer -->
        <mxCell id="db" value="Database Layer" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#ffe6cc;strokeColor=#d79b00;fontStyle=1;fontSize=14;verticalAlign=top;" vertex="1" parent="1">
          <mxGeometry x="420" y="430" width="220" height="90" as="geometry" />
        </mxCell>
        <mxCell id="db1" value="PostgreSQL Database" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;" vertex="1" parent="1">
          <mxGeometry x="440" y="460" width="180" height="40" as="geometry" />
        </mxCell>
        <mxCell id="hostRailway" value="Hosted on: Railway" style="text;fontStyle=2;fontSize=11;align=center;" vertex="1" parent="1">
          <mxGeometry x="420" y="500" width="220" height="20" as="geometry" />
        </mxCell>

        <!-- External Services -->
        <mxCell id="ext1" value="Payment Gateway\n(Razorpay/Stripe Sandbox)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="850" y="260" width="180" height="50" as="geometry" />
        </mxCell>
        <mxCell id="ext2" value="Email / SMS\nNotification Service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;strokeColor=#b85450;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="850" y="330" width="180" height="50" as="geometry" />
        </mxCell>

        <!-- Arrows -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;fontSize=10;" edge="1" parent="1" source="client1" target="be1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e1label" value="HTTPS REST API calls (JWT token)" style="text;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="480" y="185" width="220" height="20" as="geometry" />
        </mxCell>

        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="be1" target="db1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2label" value="SQLAlchemy ORM queries" style="text;fontSize=10;align=center;" vertex="1" parent="1">
          <mxGeometry x="440" y="395" width="200" height="20" as="geometry" />
        </mxCell>

        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="be5" target="ext1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e3label" value="Payment API calls" style="text;fontSize=9;align=center;" vertex="1" parent="1">
          <mxGeometry x="770" y="255" width="90" height="20" as="geometry" />
        </mxCell>

        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="be3" target="ext2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4label" value="Notification triggers" style="text;fontSize=9;align=center;" vertex="1" parent="1">
          <mxGeometry x="770" y="330" width="90" height="20" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
