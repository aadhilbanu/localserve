<mxfile host="app.diagrams.net">
  <diagram name="Class-Module Diagram" id="cmd1">
    <mxGraphModel dx="900" dy="600" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1100" pageHeight="900" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- API Layer -->
        <mxCell id="apiHeader" value="api / routers (thin - no business logic)" style="text;fontStyle=1;fontSize=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="20" width="960" height="20" as="geometry" />
        </mxCell>
        <mxCell id="api1" value="auth_router" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="50" width="130" height="35" as="geometry" />
        </mxCell>
        <mxCell id="api2" value="provider_router" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="230" y="50" width="130" height="35" as="geometry" />
        </mxCell>
        <mxCell id="api3" value="booking_router" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="50" width="130" height="35" as="geometry" />
        </mxCell>
        <mxCell id="api4" value="review_router" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="570" y="50" width="130" height="35" as="geometry" />
        </mxCell>
        <mxCell id="api5" value="payment_router" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="740" y="50" width="130" height="35" as="geometry" />
        </mxCell>

        <!-- Services Layer -->
        <mxCell id="svcHeader" value="services (business logic)" style="text;fontStyle=1;fontSize=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="150" width="960" height="20" as="geometry" />
        </mxCell>
        <mxCell id="svc1" value="AuthService" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="60" y="180" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="svc2" value="ProviderService" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="230" y="180" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="svc3" value="BookingService" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="400" y="180" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="svc4" value="ReviewService" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="570" y="180" width="140" height="40" as="geometry" />
        </mxCell>
        <mxCell id="svc5" value="PaymentService" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="740" y="180" width="140" height="40" as="geometry" />
        </mxCell>

        <!-- Models Layer -->
        <mxCell id="modelHeader" value="models (ORM entities)" style="text;fontStyle=1;fontSize=13;align=center;" vertex="1" parent="1">
          <mxGeometry x="60" y="320" width="960" height="20" as="geometry" />
        </mxCell>
        <mxCell id="m1" value="User" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="350" width="110" height="35" as="geometry" />
        </mxCell>
        <mxCell id="m2" value="ServiceProvider" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="170" y="350" width="110" height="35" as="geometry" />
        </mxCell>
        <mxCell id="m3" value="ServiceCategory" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="300" y="350" width="110" height="35" as="geometry" />
        </mxCell>
        <mxCell id="m4" value="ProviderService" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="430" y="350" width="110" height="35" as="geometry" />
        </mxCell>
        <mxCell id="m5" value="AvailabilitySlot" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="560" y="350" width="110" height="35" as="geometry" />
        </mxCell>
        <mxCell id="m6" value="Booking" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="690" y="350" width="110" height="35" as="geometry" />
        </mxCell>
        <mxCell id="m7" value="Review" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="820" y="350" width="110" height="35" as="geometry" />
        </mxCell>
        <mxCell id="m8" value="Payment" style="rounded=1;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="950" y="350" width="110" height="35" as="geometry" />
        </mxCell>

        <!-- api -> service arrows -->
        <mxCell id="e1" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="api1" target="svc1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e2" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="api2" target="svc2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e3" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="api3" target="svc3"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e4" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="api4" target="svc4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e5" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="api5" target="svc5"><mxGeometry relative="1" as="geometry" /></mxCell>

        <!-- service -> service dependency arrows -->
        <mxCell id="e6" value="depends on" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;fontSize=9;" edge="1" parent="1" source="svc3" target="svc1">
          <mxGeometry relative="1" as="geometry">
            <Array as="points"><mxPoint x="130" y="260" /></Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e7" value="depends on" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;dashed=1;fontSize=9;" edge="1" parent="1" source="svc4" target="svc3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- service -> model arrows -->
        <mxCell id="e8" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="svc1" target="m1"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e9" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="svc2" target="m2"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e10" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="svc2" target="m4"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e11" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="svc2" target="m5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e12" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="svc3" target="m6"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e13" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="svc3" target="m5"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e14" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="svc4" target="m7"><mxGeometry relative="1" as="geometry" /></mxCell>
        <mxCell id="e15" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;" edge="1" parent="1" source="svc5" target="m8"><mxGeometry relative="1" as="geometry" /></mxCell>

        <mxCell id="legend" value="solid arrow = uses/depends on   |   dashed arrow = service-to-service dependency" style="text;fontSize=10;align=left;fontStyle=2;" vertex="1" parent="1">
          <mxGeometry x="60" y="430" width="600" height="20" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
